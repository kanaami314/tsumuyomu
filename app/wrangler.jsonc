{
  "name": "tsumuyomu",
  "compatibility_date": "2026-10-01",
  // 画面(dist)はそのまま配信し、/api/ だけを Worker で扱う(論文さがしの API)
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 論文さがしのキャッシュと、日ごとの呼び出し回数(docs/operations.md の「8. 論文さがし」)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tsumuyomu-search",
      "database_id": "428e7b82-6100-46bb-b326-89b5024b427d",
      "migrations_dir": "worker/migrations"
    }
  ],
  // 秘密でない設定。キー(GEMINI_API_KEY など)は、wrangler secret put で入れる
  "vars": {
    "AI_ENABLED": "false",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "AI_DAILY_LIMIT": "20",
    "OPENALEX_DAILY_LIMIT": "50"
  }
}
